# Copy to .env (or set these in your hosting dashboard)
PORT=3000
# Long random string. If unset, one is generated and stored in data/.session-secret
SESSION_SECRET=
# Where the SQLite database and uploaded photos live
DATA_DIR=./data
# Used for "today", due dates and receipts
TZ_NAME=Asia/Colombo
# Set to 1 when running behind HTTPS (cookies become Secure)
COOKIE_SECURE=0
# Password for the first admin account (username: admin). If unset, a random one is printed on first start.
ADMIN_PASSWORD=
