<%- include('partials/top') %>
<div class="page-head"><div><h1>Change password</h1></div></div>
<form class="card" method="post" action="/account/password" style="max-width:460px">
  <div class="card-pad">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% for (const [name, label, ac] of [['current', 'Current password', 'current-password'], ['password', 'New password', 'new-password'], ['confirm', 'Confirm new password', 'new-password']]) { %>
      <div class="field <%= errors[name] ? 'has-error' : '' %>">
        <label for="<%= name %>"><%= label %></label>
        <input type="password" id="<%= name %>" name="<%= name %>" autocomplete="<%= ac %>" required>
        <% if (errors[name]) { %><span class="error"><%= errors[name] %></span><% } %>
      </div>
    <% } %>
    <p class="help small muted">At least 8 characters.</p>
  </div>
  <div class="form-actions"><a class="btn" href="/">Cancel</a><button class="btn btn-primary" type="submit">Save password</button></div>
</form>
<%- include('partials/bottom') %>
